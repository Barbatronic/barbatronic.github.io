---
layout: null
permalink: /feed.xml
---
{%- comment -%}
  Flux Atom du site : articles et logs mélangés, du plus récent au plus ancien (30 entrées).
  Remplace le flux de jekyll-feed, qui ne génère rien quand ce fichier existe (la balise feed_meta
  de head.html continue de l'annoncer). Langue par défaut uniquement : les traductions EN
  dupliqueraient les entrées.
  Titre d'un log : "<code projet> <Lxx> · <titre>".
{%- endcomment -%}
{%- assign _posts = site.posts | where: "lang", site.default_lang -%}
{%- assign entries = _posts | concat: site.logs | sort: "date" | reverse -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ site.default_lang }}">
  <generator uri="https://jekyllrb.com/" version="{{ jekyll.version }}">Jekyll</generator>
  <link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml" />
  <link href="{{ '/' | absolute_url }}" rel="alternate" type="text/html" />
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ '/feed.xml' | absolute_url | xml_escape }}</id>
  <title type="html">{{ site.title | xml_escape }}</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <author><name>{{ site.author.name | xml_escape }}</name></author>
  {%- for e in entries limit: 30 %}
  {%- assign _url = e.url | absolute_url -%}
  {%- if e.collection == "logs" -%}
    {%- include log-number.html item=e -%}
    {%- assign _proj = site.projects | where: "slug", e.project | first -%}
    {%- capture _title %}{{ _proj.code }} {{ log_code }} · {{ e.title }}{% endcapture -%}
    {%- assign _kind = "Log" -%}
  {%- else -%}
    {%- assign _title = e.title -%}
    {%- assign _kind = "Article" -%}
  {%- endif %}
  <entry>
    <title type="html">{{ _title | strip | xml_escape }}</title>
    <link href="{{ _url }}" rel="alternate" type="text/html" />
    <id>{{ _url | xml_escape }}</id>
    <published>{{ e.date | date_to_xmlschema }}</published>
    <updated>{{ e.date | date_to_xmlschema }}</updated>
    <category term="{{ _kind }}" />
    {%- if e.description and e.description != "" %}
    <summary type="html">{{ e.description | xml_escape }}</summary>
    {%- endif %}
    <content type="html" xml:base="{{ _url }}"><![CDATA[{{ e.content | replace: "]]>", "]]&gt;" }}]]></content>
  </entry>
  {%- endfor %}
</feed>
