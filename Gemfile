# Build local identique à GitHub Pages.
# Installation : bundle install
# Serveur local : bundle exec jekyll serve --livereload
# Avec les contenus en brouillon (published: false) : ajouter --unpublished
source "https://rubygems.org"

gem "github-pages", group: :jekyll_plugins
gem "webrick", "~> 1.8" # requis avec Ruby >= 3
